# Optional: full URI wins over the split variables below
# MONGODB_URI=

# Atlas (mongodb+srv) — cluster is the host only, e.g. cluster0.xxxxx.mongodb.net
# You can use MONGO_* names or: mongo_username, password, cluster, database
MONGO_USERNAME=
MONGO_PASSWORD=
# Atlas — use the full host from Atlas → Connect → Drivers (e.g. cluster0.ab12cd.mongodb.net), not just "cluster0"
MONGO_CLUSTER=
MONGO_DATABASE=

PORT=3000
NODE_ENV=development

# HS256 signing secret — required in production (32+ random characters)
JWT_SECRET=
# Access token lifetime (e.g. 15m, 1h, 7d — shorter = smaller exposure if leaked)
JWT_EXPIRES_IN=7d
# bcrypt cost factor (10–12 typical; use lower values only in automated tests)
BCRYPT_COST=12
